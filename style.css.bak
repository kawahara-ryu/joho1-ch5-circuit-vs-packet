:root {
    --mat-green: #dff5f0;
    --mat-grid: rgba(37, 99, 235, 0.07);
    --paper-cream: #ffffff;
    --paper-warm: #fff8ed;
    --paper-border: #d8cee6;
    --cardboard: #ffefb8;
    --cardboard-dark: #b45309;
    --ink-black: #281e36;
    --ink-muted: #5b4d6e;
    --postal-red: #f43f5e;
    --postal-blue: #2563eb;
    --postal-green: #0ca678;
    --brass-gold: #f59e0b;
    --sticky-yellow: #fef08a;
    --bakelite-dark: #2c2242;
    --panel-metal: #382c54;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'M PLUS Rounded 1c', sans-serif;
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0, "calt" 0;
}

body {
    background-color: var(--mat-green);
    background-image:
        radial-gradient(rgba(12, 166, 120, 0.14) 1.5px, transparent 1.5px),
        linear-gradient(var(--mat-grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--mat-grid) 1px, transparent 1px);
    background-size: 24px 24px, 24px 24px, 24px 24px;
    color: var(--ink-black);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    user-select: none;
}

.mono-num,
code,
pre {
    font-family: 'Courier Prime', Consolas, Monaco, monospace;
    font-variant-ligatures: none !important;
    font-feature-settings: "liga" 0, "calt" 0 !important;
}

.u-title-chunk {
    display: inline-block;
    word-break: keep-all;
}

/* ===== HEADER ===== */
.postal-header {
    background: var(--bakelite-dark);
    color: var(--paper-cream);
    border-bottom: 4px solid var(--brass-gold);
    padding: 10px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    box-shadow: 0 3px 0 rgba(40, 30, 54, 0.2);
}

.postal-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 1.02rem;
}

.post-mark {
    background: var(--postal-red);
    color: #fff;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    border: 2px solid #fff;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
}

.header-controls {
    display: flex;
    gap: 10px;
}

/* ===== SCREENS ===== */
.screen {
    display: none;
    flex: 1;
    width: 100%;
    max-width: 1220px;
    margin: 0 auto;
    padding: 16px 16px;
    flex-direction: column;
    justify-content: center;
}

.screen.active {
    display: flex;
}

/* 紙めくりアニメーション */
.page-flip-anim {
    animation: paperFlip 0.32s ease-out;
}

@keyframes paperFlip {
    0% {
        transform: translateY(10px) rotate(-0.6deg);
        opacity: 0.4;
    }

    100% {
        transform: translateY(0) rotate(0);
        opacity: 1;
    }
}

/* ===== AIRMAIL & PAPER SHEET ===== */
.airmail-frame {
    background: repeating-linear-gradient(-45deg,
            #ff5c7c 0px,
            #ff5c7c 14px,
            #ffffff 14px,
            #ffffff 24px,
            #38bdf8 24px,
            #38bdf8 38px,
            #ffffff 38px,
            #ffffff 48px);
    padding: 11px;
    border-radius: 18px;
    border: 3px solid var(--ink-black);
    box-shadow: 7px 7px 0 var(--ink-black);
    max-width: 940px;
    width: 100%;
    margin: 0 auto;
}

.document-sheet {
    background: var(--paper-cream);
    border: 2.5px solid var(--ink-black);
    border-radius: 12px;
    padding: 26px 30px;
    position: relative;
}

.doc-stamp-top {
    display: inline-block;
    border: 2px solid var(--postal-red);
    color: var(--postal-red);
    font-weight: 900;
    font-size: 0.82rem;
    padding: 4px 14px;
    border-radius: 999px;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
    background: #fff0f3;
}

.main-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    color: var(--ink-black);
    line-height: 1.25;
    margin-bottom: 4px;
}

.sub-title {
    font-size: clamp(0.98rem, 2.1vw, 1.2rem);
    font-weight: 700;
    color: var(--postal-blue);
    margin-bottom: 18px;
}

/* ===== TITLE VS SHOWCASE ===== */
.vs-showcase {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
}

.char-card {
    flex: 1 1 260px;
    max-width: 340px;
    background: #fff;
    border: 3px solid var(--ink-black);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 4px 4px 0 var(--paper-border);
}

.card-tag {
    width: 100%;
    text-align: center;
    font-weight: 900;
    font-size: 0.85rem;
    padding: 4px 8px;
    border-radius: 6px;
    margin-bottom: 10px;
    color: #fff;
}

.tag-circuit {
    background: var(--postal-red);
}

.tag-packet {
    background: var(--postal-green);
}

.char-illust {
    width: 130px;
    height: 130px;
    object-fit: contain;
    margin-bottom: 8px;
}

.char-caption {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.char-caption strong {
    font-size: 1rem;
    color: var(--ink-black);
}

.char-caption span {
    font-size: 0.84rem;
    color: var(--ink-muted);
    font-weight: 700;
}

.vs-emblem {
    align-self: center;
    background: var(--brass-gold);
    color: #fff;
    font-weight: 900;
    font-size: 1.15rem;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 3px solid var(--ink-black);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 3px 3px 0 var(--ink-black);
}

/* ===== STORY MEMO ===== */
.story-memo {
    background: var(--paper-warm);
    border: 2px dashed var(--cardboard-dark);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 20px;
    text-align: left;
}

.memo-title {
    font-weight: 900;
    color: var(--cardboard-dark);
    font-size: 1rem;
    margin-bottom: 8px;
    border-bottom: 2px solid var(--paper-border);
    padding-bottom: 4px;
}

.memo-body {
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 10px;
    color: var(--ink-black);
}

.step-preview-list {
    padding-left: 22px;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--ink-black);
}

.title-action-row {
    text-align: center;
}

/* ===== RETRO BUTTONS ===== */
.retro-btn {
    border: 3px solid var(--ink-black);
    background: var(--paper-cream);
    color: var(--ink-black);
    font-weight: 900;
    font-size: 0.95rem;
    padding: 9px 18px;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 0 var(--ink-black);
    transition: transform 0.08s, background-color 0.15s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.retro-btn:hover:not(:disabled) {
    background: #fff;
}

.retro-btn:active:not(:disabled) {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--ink-black);
}

.retro-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.btn-small {
    padding: 6px 12px;
    font-size: 0.84rem;
    box-shadow: 0 3px 0 #000;
}

.btn-large {
    padding: 14px 30px;
    font-size: 1.12rem;
}

.btn-primary {
    background: var(--postal-green);
    color: #fff;
}

.btn-primary:hover:not(:disabled) {
    background: #257348;
}

.btn-danger {
    background: var(--postal-red);
    color: #fff;
}

.btn-danger:hover:not(:disabled) {
    background: #cf322c;
}

.btn-secondary {
    background: var(--brass-gold);
    color: #fff;
}

.btn-secondary:hover:not(:disabled) {
    background: #d9a436;
}

/* ===== STAGE BAR ===== */
.stage-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--paper-cream);
    border: 3px solid var(--ink-black);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 14px;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
    flex-wrap: wrap;
    gap: 8px;
}

.stage-steps {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.step-pill {
    padding: 5px 11px;
    border-radius: 6px;
    border: 2px solid var(--paper-border);
    background: var(--paper-warm);
    font-size: 0.82rem;
    font-weight: 900;
    color: var(--ink-muted);
    cursor: pointer;
    transition: transform 0.1s, background-color 0.15s;
}

.step-pill:hover {
    transform: translateY(-1px);
    border-color: var(--ink-black);
    color: var(--ink-black);
}

.step-pill.active {
    background: var(--postal-blue);
    color: #fff;
    border-color: var(--ink-black);
    box-shadow: 0 2px 0 var(--ink-black);
}

.step-pill.done {
    background: var(--postal-green);
    color: #fff;
    border-color: var(--ink-black);
}

.score-plate {
    background: var(--bakelite-dark);
    color: var(--sticky-yellow);
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 900;
    font-size: 0.9rem;
    border: 2px solid var(--brass-gold);
}

.miss-counter {
    font-size: 0.8rem;
    color: #ff9c97;
    margin-left: 4px;
}

/* ===== WORKSPACE 2-COLUMN GRID ===== */
.workspace-grid {
    display: flex;
    gap: 16px;
    align-items: stretch;
    flex: 1;
}

.operator-column {
    flex: 0 0 285px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.id-card-box {
    background: var(--paper-cream);
    border: 3px solid var(--ink-black);
    border-radius: 10px;
    padding: 12px;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
}

.id-card-header {
    background: var(--postal-blue);
    color: #fff;
    font-weight: 900;
    font-size: 0.84rem;
    padding: 5px 10px;
    border-radius: 5px;
    text-align: center;
    margin-bottom: 8px;
    transition: background-color 0.2s;
}

.id-card-header.alert-mode {
    background: var(--postal-red);
    color: var(--sticky-yellow);
}

.id-card-header.ok-mode {
    background: var(--postal-green);
    color: #fff;
}

.id-photo-wrap {
    background: radial-gradient(circle at 50% 55%, #ffffff 45%, #f4ead5 100%);
    border: 2.5px solid var(--ink-black);
    border-radius: 8px;
    padding: 8px 6px 4px 6px;
    text-align: center;
    margin-bottom: 8px;
    position: relative;
    overflow: hidden;
    transition: background 0.25s, border-color 0.25s;
}

.id-photo-wrap.mood-alert {
    background: radial-gradient(circle at 50% 55%, #fff5f5 35%, #ffc9c4 100%);
    border-color: var(--postal-red);
    animation: avatar-shake 0.38s ease-in-out;
}

.id-photo-wrap.mood-ok {
    background: radial-gradient(circle at 50% 55%, #f7fff9 35%, #c5eed2 100%);
    border-color: var(--postal-green);
    animation: avatar-bounce 0.42s ease-out;
}

.id-photo-wrap.mood-madam {
    background: radial-gradient(circle at 50% 55%, #fffdf5 35%, #f5dfb0 100%);
    border-color: var(--brass-gold);
}

.emotion-badge {
    position: absolute;
    top: 5px;
    right: 6px;
    background: var(--postal-blue);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 900;
    padding: 2px 8px;
    border-radius: 20px;
    border: 1.5px solid var(--ink-black);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
    z-index: 2;
}

.id-photo-wrap.mood-alert .emotion-badge {
    background: var(--postal-red);
    color: var(--sticky-yellow);
}

.id-photo-wrap.mood-ok .emotion-badge {
    background: var(--postal-green);
    color: #fff;
}

.id-photo-wrap.mood-madam .emotion-badge {
    background: var(--brass-gold);
    color: #fff;
}

@keyframes avatar-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-4px) rotate(-1.5deg); }
    40% { transform: translateX(4px) rotate(1.5deg); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(3px); }
}

@keyframes avatar-bounce {
    0% { transform: scale(0.95); }
    50% { transform: translateY(-4px) scale(1.03); }
    100% { transform: translateY(0) scale(1); }
}

.speaker-avatar {
    width: 112px;
    height: 112px;
    object-fit: contain;
    mix-blend-mode: multiply;
}

.speech-sheet {
    background: #fff;
    border: 2.5px solid var(--ink-black);
    border-radius: 12px;
    padding: 11px 13px;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.52;
    color: var(--ink-black);
    min-height: 92px;
    text-align: left;
    position: relative;
    margin-top: 4px;
    box-shadow: 0 3px 0 rgba(40, 30, 54, 0.12);
}

.speech-sheet::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 28px;
    border-width: 0 9px 10px 9px;
    border-style: solid;
    border-color: transparent transparent var(--ink-black) transparent;
}

.speech-sheet::after {
    content: "";
    position: absolute;
    top: -6px;
    left: 30px;
    border-width: 0 7px 8px 7px;
    border-style: solid;
    border-color: transparent transparent #ffffff transparent;
}

.speech-sheet.speech-pop {
    animation: speech-pop-anim 0.22s ease-out;
}

@keyframes speech-pop-anim {
    0% { transform: scale(0.97); }
    60% { transform: scale(1.015); }
    100% { transform: scale(1); }
}

/* 次に押すべきボタンの直感パルスガイド */
.pulse-guide:not(:disabled) {
    box-shadow: 0 4px 0 var(--ink-black), 0 0 0 3px rgba(242, 183, 5, 0.75);
    animation: guide-pulse 1.35s infinite ease-in-out;
}

@keyframes guide-pulse {
    0%, 100% {
        box-shadow: 0 4px 0 var(--ink-black), 0 0 0 2px rgba(242, 183, 5, 0.55);
    }
    50% {
        box-shadow: 0 4px 0 var(--ink-black), 0 0 0 6px rgba(242, 183, 5, 0.95);
    }
}

.pulse-danger:not(:disabled) {
    box-shadow: 0 4px 0 var(--ink-black), 0 0 0 3px rgba(207, 50, 44, 0.75);
    animation: danger-pulse 1.1s infinite ease-in-out;
}

@keyframes danger-pulse {
    0%, 100% {
        box-shadow: 0 4px 0 var(--ink-black), 0 0 0 2px rgba(207, 50, 44, 0.55);
    }
    50% {
        box-shadow: 0 4px 0 var(--ink-black), 0 0 0 6px rgba(255, 224, 102, 0.95);
    }
}

/* 付箋メモ */
.sticky-note {
    background: var(--sticky-yellow);
    border: 2px solid #d4b84c;
    border-left: 8px solid var(--brass-gold);
    border-radius: 6px;
    padding: 11px 13px;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.25);
    text-align: left;
}

.sticky-pin {
    font-size: 0.76rem;
    font-weight: 900;
    color: var(--cardboard-dark);
    margin-bottom: 3px;
}

.sticky-title {
    font-size: 0.92rem;
    font-weight: 900;
    color: var(--ink-black);
    margin-bottom: 4px;
}

.sticky-desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-black);
}

/* ===== RIGHT COLUMN: WORKBENCH ===== */
.workbench-column {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    position: relative;
}

.workbench-board {
    background: var(--paper-cream);
    border: 3px solid var(--ink-black);
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: 6px 6px 0 var(--ink-black);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
}

.board-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid var(--ink-black);
    padding-bottom: 8px;
    gap: 10px;
    flex-wrap: wrap;
}

.board-title {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--ink-black);
}

.board-badge {
    background: var(--brass-gold);
    color: #fff;
    font-weight: 900;
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: 20px;
    border: 2px solid var(--ink-black);
}

.stage-mount {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: space-between;
}

/* 紙テープ印字ログ */
.ticker-tape-box {
    background: var(--bakelite-dark);
    color: #f5eedc;
    border: 2px solid var(--ink-black);
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
}

.ticker-label {
    color: var(--brass-gold);
    font-weight: 900;
    white-space: nowrap;
}

.ticker-text {
    color: #fff;
    font-weight: 700;
}

/* ===== STAGE 1: 黒電話スイッチ盤（回線交換・無言紅茶・イライラゲージ） ===== */
.switchboard-panel {
    background: var(--panel-metal);
    color: var(--paper-cream);
    border: 3px solid var(--ink-black);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.trunk-line-box {
    background: #251c3b;
    border: 3px solid var(--brass-gold);
    border-radius: 10px;
    padding: 12px;
    text-align: center;
}

.trunk-label {
    font-size: 0.86rem;
    font-weight: 900;
    color: var(--sticky-yellow);
    margin-bottom: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

.wire-visual {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px;
    background: #33274f;
    border-radius: 8px;
}

.endpoint-box {
    background: var(--paper-cream);
    color: var(--ink-black);
    padding: 6px 10px;
    border-radius: 6px;
    font-weight: 900;
    font-size: 0.84rem;
    border: 2px solid var(--ink-black);
    min-width: 115px;
}

.cable-pipe {
    flex: 1;
    min-height: 32px;
    padding: 4px 10px;
    background: #444;
    border: 2px solid #000;
    border-radius: 15px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 900;
    color: #ccc;
}

.cable-pipe.occupied {
    background: repeating-linear-gradient(45deg,
            var(--postal-red),
            var(--postal-red) 12px,
            #8a1c18 12px,
            #8a1c18 24px);
    color: #fff;
}

.cable-pipe.silent-tea {
    background: repeating-linear-gradient(45deg,
            #6b4c1f,
            #6b4c1f 12px,
            #4a3312 12px,
            #4a3312 24px);
    color: var(--sticky-yellow);
}

.cable-pipe.packet-shared {
    background: #1e5c3a;
    border-color: var(--brass-gold);
    color: #fff;
    gap: 6px;
    flex-wrap: wrap;
}

.mini-pkt {
    background: var(--paper-cream);
    color: var(--ink-black);
    border: 1.5px solid var(--ink-black);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.74rem;
    font-weight: 900;
    display: inline-block;
}

.anger-meter-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    background: #26201d;
    padding: 6px 10px;
    border-radius: 6px;
}

.anger-bar-bg {
    flex: 1;
    height: 12px;
    background: #111;
    border-radius: 6px;
    border: 1px solid #666;
    overflow: hidden;
}

.anger-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--postal-red);
    transition: width 0.3s ease;
}

.callers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
}

.caller-slot {
    background: var(--paper-cream);
    color: var(--ink-black);
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
}

.caller-slot.blocked {
    background: #ffe8e6;
    border-color: var(--postal-red);
}

.caller-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 900;
    font-size: 0.86rem;
    gap: 6px;
    white-space: nowrap;
}

.caller-status {
    font-size: 0.74rem;
    padding: 2px 7px;
    border-radius: 4px;
    background: #ddd;
    color: var(--ink-black);
    white-space: nowrap;
}

.caller-status.busy {
    background: var(--postal-red);
    color: #fff;
}

.caller-status.talking {
    background: var(--postal-green);
    color: #fff;
}

/* ===== STAGE 2: パケット分割サイズ実験＆ヘッダ荷札貼り ===== */
.packing-desk {
    background: var(--paper-warm);
    border: 3px solid var(--cardboard-dark);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.scroll-banner {
    background: #fff;
    border: 3px solid var(--ink-black);
    border-radius: 8px;
    padding: 12px;
    text-align: center;
}

.raw-message-strip {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;
    margin: 8px 0;
}

.payload-piece {
    background: #fff9db;
    border: 2px solid var(--ink-black);
    padding: 7px 12px;
    font-weight: 900;
    font-size: 0.98rem;
    color: var(--ink-black);
}

.raw-message-strip.split-done {
    gap: 12px;
}

.raw-message-strip.split-done .payload-piece {
    border-style: dashed;
    background: #fff;
    border-radius: 6px;
}

.overhead-alert-box {
    background: #ffe8e6;
    border: 2px solid var(--postal-red);
    border-radius: 8px;
    padding: 10px 12px;
    text-align: left;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-black);
}

/* 第二工程：本体(ペイロード) vs 荷札(ヘッダ) 通信量内訳メーター */
.byte-meter-box {
    background: #faf6ed;
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 8px 12px;
    margin-top: 8px;
    text-align: left;
}

.byte-meter-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 900;
    margin-bottom: 5px;
    flex-wrap: wrap;
    gap: 6px;
}

.byte-bar-track {
    width: 100%;
    height: 24px;
    background: #e2d9c8;
    border: 2px solid var(--ink-black);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
}

.byte-seg-payload {
    background: var(--postal-blue);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    overflow: hidden;
    transition: width 0.35s ease;
}

.byte-seg-header {
    background: var(--postal-red);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    overflow: hidden;
    border-left: 2px solid var(--ink-black);
    transition: width 0.35s ease;
}

.mijingiri-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
}

.tiny-parcel {
    background: var(--cardboard);
    border: 1.5px solid var(--ink-black);
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 0.7rem;
    font-weight: 900;
}

.tiny-parcel span {
    background: var(--postal-red);
    color: #fff;
    padding: 0 3px;
    border-radius: 2px;
    margin-right: 2px;
}

.parcels-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

.parcel-box {
    background: var(--cardboard);
    border: 3px solid var(--ink-black);
    border-radius: 8px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    box-shadow: 3px 3px 0 var(--cardboard-dark);
}

.header-tag-slot {
    background: rgba(255, 255, 255, 0.55);
    border: 2px dashed var(--ink-black);
    border-radius: 5px;
    padding: 5px 3px;
    font-size: 0.72rem;
    text-align: center;
    min-height: 54px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
}

.ip-tag-line {
    font-size: 0.62rem;
    font-weight: 900;
    color: var(--ink-black);
    white-space: nowrap;
    letter-spacing: -0.025em;
    line-height: 1.38;
}

.header-tag-slot.tagged {
    background: #fff;
    border-style: solid;
    border-color: var(--postal-red);
}

.tag-badge-red {
    background: var(--postal-red);
    color: #fff;
    font-weight: 900;
    font-size: 0.7rem;
    padding: 1px 6px;
    border-radius: 3px;
    display: inline-block;
    margin-bottom: 2px;
}

.payload-slot {
    background: var(--paper-cream);
    border: 2px solid var(--ink-black);
    border-radius: 5px;
    padding: 6px 4px;
    text-align: center;
    font-weight: 900;
    font-size: 0.86rem;
}

/* ===== STAGE 3: 共有・渋滞バッファ・障害迂回ルーティング (Canvas) ===== */
.routing-console {
    background: #f5f0ff;
    border: 3px solid var(--ink-black);
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.canvas-frame {
    background: #fffdf9;
    border: 3px solid var(--ink-black);
    border-radius: 10px;
    overflow: hidden;
    text-align: center;
}

#network-canvas {
    width: 100%;
    max-width: 720px;
    height: auto;
    display: block;
    margin: 0 auto;
}

.router-control-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--paper-cream);
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 10px 12px;
    flex-wrap: wrap;
    gap: 10px;
}

.arrival-log-strip {
    background: var(--bakelite-dark);
    color: var(--paper-cream);
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 7px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 900;
}

.arrived-chip {
    background: var(--cardboard);
    color: var(--ink-black);
    border: 1.5px solid #fff;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 0.76rem;
    font-weight: 900;
    display: inline-block;
}

.lost-chip {
    background: var(--postal-red);
    color: #fff;
    border: 1.5px dashed var(--sticky-yellow);
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 0.76rem;
    font-weight: 900;
    display: inline-block;
}

/* 第四工程：通し番号（シーケンス番号）歯抜けチェック伝票 */
.seq-check-strip {
    background: #fff;
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 7px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px;
}

.seq-chips-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.seq-chip {
    padding: 3px 8px;
    border-radius: 5px;
    font-size: 0.76rem;
    font-weight: 900;
    border: 2px solid var(--ink-black);
}

.seq-chip.seq-ok {
    background: #e6f7ea;
    border-color: var(--postal-green);
    color: var(--postal-green);
}

.seq-chip.seq-missing {
    background: #ffe3e0;
    border-style: dashed;
    border-color: var(--postal-red);
    color: var(--postal-red);
}

/* ===== STAGE 4: TCP vs UDP 比較＆順番復元デスク ===== */
.assembly-desk {
    background: var(--paper-warm);
    border: 3px solid var(--ink-black);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.protocol-mode-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 8px 12px;
    flex-wrap: wrap;
    gap: 8px;
}

.udp-live-banner {
    background: var(--bakelite-dark);
    color: var(--sticky-yellow);
    border: 2px solid var(--brass-gold);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.86rem;
    font-weight: 700;
}

.tray-label {
    font-weight: 900;
    font-size: 0.88rem;
    color: var(--ink-black);
    margin-bottom: 4px;
}

.incoming-Pool,
.ordered-slots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
}

.packet-card {
    background: var(--cardboard);
    border: 3px solid var(--ink-black);
    border-radius: 8px;
    padding: 7px;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--ink-black);
    text-align: center;
    transition: transform 0.1s;
}

.packet-card:hover {
    transform: translateY(-2px);
    background: #e3b478;
}

.packet-card.missing-card {
    background: #ffe3e0;
    border: 3px dashed var(--postal-red);
    cursor: default;
    box-shadow: none;
}

.slot-target {
    background: #fff;
    border: 3px dashed var(--postal-blue);
    border-radius: 8px;
    padding: 8px 6px;
    min-height: 82px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 3px;
}

.slot-target.filled {
    background: #eef7f0;
    border-style: solid;
    border-color: var(--postal-green);
    cursor: pointer;
}

/* ===== STAGE 5: 小規模LANの構築と経路実験（分岐トポロジ構造） ===== */
.lan-builder-desk {
    background: var(--paper-warm);
    border: 3px solid var(--ink-black);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.wan-lan-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    background: #fff;
    border: 3px solid var(--ink-black);
    border-radius: 8px;
    padding: 8px 6px;
    overflow: hidden;
}

.zone-box {
    padding: 5px 4px;
    border-radius: 8px;
    border: 2px solid var(--ink-black);
    text-align: center;
    flex: 0 0 80px;
    font-weight: 900;
    font-size: 0.7rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: all 0.15s;
}

.zone-wan {
    background: #dce8f5;
    border-color: var(--postal-blue);
    min-height: 84px;
}

.zone-wan.wan-broken {
    background: #ffdcd9 !important;
    border-color: var(--postal-red) !important;
    border-style: dashed !important;
    color: var(--postal-red);
}

.wan-lan-wall {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2px 2px;
    border-left: 2px dashed var(--postal-red);
    border-right: 2px dashed var(--postal-red);
    background: #fff5f5;
    color: var(--postal-red);
    font-weight: 900;
    font-size: 0.6rem;
    line-height: 1.1;
    text-align: center;
    align-self: stretch;
    flex: 0 0 24px;
}

.lan-slot {
    flex: 0 0 98px;
    width: 98px;
    min-height: 82px;
    border: 2.5px dashed var(--postal-blue);
    border-radius: 8px;
    background: #faf6ed;
    padding: 4px 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: all 0.15s;
    overflow: hidden;
}

.lan-slot.filled-ok {
    background: #e6f7ea;
    border-style: solid;
    border-color: var(--postal-green);
}

.lan-slot.filled-ng {
    background: #ffe3e0;
    border-style: solid;
    border-color: var(--postal-red);
}

.lan-slot.target-slot-active {
    border: 3px solid var(--brass-gold);
    background: #fff9db;
    box-shadow: 0 0 0 3px rgba(201, 150, 44, 0.35);
}

.s5-analyzer-bar {
    background: var(--bakelite-dark);
    color: var(--paper-cream);
    border: 2px solid var(--brass-gold);
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.45;
}

.manual-diagram-box {
    background: var(--paper-warm);
    border: 2px dashed var(--ink-black);
    border-radius: 6px;
    padding: 8px 10px;
    margin: 6px 0 8px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 900;
}

.diag-tag-red {
    background: var(--postal-red);
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
}

.diag-tag-blue {
    background: var(--postal-blue);
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
}

.diag-tag-green {
    background: var(--postal-green);
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
}

.lan-slot.route-glow,
.zone-box.route-glow,
.branch-endpoint.route-glow {
    background: var(--sticky-yellow) !important;
    border-color: var(--postal-red) !important;
    box-shadow: 0 0 0 2.5px var(--postal-red);
}

.lan-slot.slot-broken {
    background: #ffdcd9 !important;
    border-color: var(--postal-red) !important;
    border-style: dashed !important;
    opacity: 0.85;
}

/* スイッチングハブからの上下二股分岐エリア */
.hub-branches-col {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: 4px solid var(--ink-black);
    padding-left: 6px;
    margin-left: 2px;
}

.branch-lane {
    display: flex;
    align-items: center;
    gap: 4px;
    background: #f5efe2;
    border: 2px solid var(--paper-border);
    border-radius: 8px;
    padding: 4px 5px;
}

.branch-tag {
    font-size: 0.68rem;
    font-weight: 900;
    color: var(--ink-black);
    white-space: nowrap;
}

.branch-endpoint {
    flex: 1 1 auto;
    padding: 5px 5px;
    border: 2px solid var(--ink-black);
    border-radius: 6px;
    background: #fff;
    font-weight: 900;
    font-size: 0.72rem;
    text-align: center;
    white-space: nowrap;
    transition: all 0.15s;
}

.lan-slot.ap-branch-slot {
    flex: 1 1 138px;
    width: auto;
    min-height: 56px;
    padding: 3px 4px;
}

.cable-arrow {
    font-weight: 900;
    font-size: 0.75rem;
    color: var(--ink-black);
    white-space: nowrap;
}

.device-parts-pool {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
}

.device-part-card {
    background: var(--cardboard);
    border: 3px solid var(--ink-black);
    border-radius: 8px;
    padding: 8px;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--ink-black);
}

.device-part-card:hover {
    background: #e6b87d;
}

.device-part-card.used {
    opacity: 0.35;
    cursor: default;
    box-shadow: none;
}

/* ===== HANKO STAMP (本格二重枠・朱肉受領印) & CONFETTI ===== */
.hanko-stamp {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-12deg);
    border: 7px double var(--postal-red);
    color: var(--postal-red);
    background: rgba(255, 248, 242, 0.96);
    font-size: 2.35rem;
    font-weight: 900;
    padding: 10px 26px;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(184, 41, 36, 0.35), inset 0 0 0 2px rgba(184, 41, 36, 0.25);
    pointer-events: none;
    z-index: 60;
    text-align: center;
    line-height: 1.15;
    animation: stamp-pop 0.26s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.hanko-stamp::before {
    content: "〒 ねこ村通信局・検収印";
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    border-bottom: 2px solid var(--postal-red);
    padding-bottom: 3px;
    margin-bottom: 4px;
}

@keyframes stamp-pop {
    0% {
        transform: translate(-50%, -50%) scale(2.8) rotate(-22deg);
        opacity: 0;
    }
    70% {
        transform: translate(-50%, -50%) scale(0.94) rotate(-10deg);
        opacity: 1;
    }
    100% {
        transform: translate(-50%, -50%) scale(1) rotate(-12deg);
        opacity: 1;
    }
}

.confetti-piece {
    position: fixed;
    top: -18px;
    width: 11px;
    height: 16px;
    border: 1.5px solid var(--ink-black);
    border-radius: 2px;
    z-index: 9999;
    pointer-events: none;
    animation: confetti-fall linear forwards;
}

@keyframes confetti-fall {
    0% {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
    }
    85% {
        opacity: 1;
    }
    100% {
        transform: translateY(102vh) rotate(540deg);
        opacity: 0;
    }
}

/* ===== CLEAR SCREEN ===== */
.clear-sheet {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.clear-title {
    font-size: clamp(1.5rem, 3.2vw, 2.05rem);
    font-weight: 900;
    color: var(--ink-black);
    text-align: center;
}

.report-top-grid {
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap;
}

.report-char-box {
    flex: 0 0 155px;
    text-align: center;
    position: relative;
    margin: 0 auto;
}

.clear-illust {
    width: 125px;
    height: 125px;
    object-fit: contain;
    background: #fff;
    border: 3px solid var(--ink-black);
    border-radius: 10px;
    padding: 6px;
}

.final-rank-stamp {
    position: absolute;
    bottom: -6px;
    right: 4px;
    background: #fff8f6;
    border: 4px solid var(--postal-red);
    color: var(--postal-red);
    font-weight: 900;
    font-size: 1.15rem;
    padding: 3px 10px;
    border-radius: 8px;
    transform: rotate(-12deg);
}

.report-summary-table {
    flex: 1 1 360px;
}

.ledger-table,
.compare-table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border: 2px solid var(--ink-black);
    font-size: 0.88rem;
}

.ledger-table th,
.ledger-table td,
.compare-table th,
.compare-table td {
    border: 1px solid var(--ink-black);
    padding: 7px 11px;
    text-align: left;
    line-height: 1.48;
}

.ledger-table th {
    background: var(--paper-warm);
    width: 130px;
    font-weight: 900;
}

.comparison-sheet {
    background: var(--paper-warm);
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 12px;
}

.sheet-caption {
    font-weight: 900;
    font-size: 0.92rem;
    margin-bottom: 8px;
}

.compare-table thead th {
    background: var(--bakelite-dark);
    color: #fff;
}

.compare-table th.col-item {
    white-space: nowrap;
    width: 120px;
    background: var(--paper-warm);
    color: var(--ink-black);
    font-weight: 900;
}

.compare-table thead th.col-item {
    background: var(--bakelite-dark);
    color: #fff;
}

.compare-table thead th.col-circuit {
    background: var(--postal-red);
}

.compare-table thead th.col-packet {
    background: var(--postal-green);
}

.keyword-sheet {
    background: #fff;
    border: 3px solid var(--postal-blue);
    border-radius: 10px;
    padding: 14px;
    text-align: center;
}

.keyword-instruction {
    font-weight: 900;
    font-size: 0.92rem;
    color: var(--ink-black);
    margin-bottom: 8px;
}

.keyword-copy-row {
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
}

.keyword-value {
    background: var(--sticky-yellow);
    border: 2px dashed var(--ink-black);
    padding: 9px 16px;
    font-size: 1.1rem;
    font-weight: 900;
    border-radius: 6px;
    color: var(--ink-black);
}

.btn-copy {
    background: var(--postal-blue);
    color: #fff;
}

.clear-action-row {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}

/* ===== MODALS ===== */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20, 16, 12, 0.72);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 900;
}

.modal-card {
    background: var(--paper-cream);
    border: 4px solid var(--ink-black);
    border-radius: 12px;
    padding: 22px;
    max-width: 580px;
    width: 100%;
    box-shadow: 8px 8px 0 #000;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
}

.modal-wide {
    max-width: 760px;
    max-height: 88vh;
}

.modal-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid var(--ink-black);
    padding-bottom: 8px;
}

.modal-stamp {
    display: inline-block;
    align-self: flex-start;
    background: var(--postal-green);
    color: #fff;
    font-weight: 900;
    font-size: 0.8rem;
    padding: 3px 10px;
    border-radius: 4px;
}

.modal-title {
    font-size: 1.25rem;
    font-weight: 900;
}

.modal-desc {
    font-size: 0.92rem;
    line-height: 1.55;
}

.mini-quiz-box {
    background: #fff;
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.mini-quiz-q {
    font-weight: 900;
    font-size: 0.95rem;
    color: var(--postal-blue);
}

.mini-quiz-Choices {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.quiz-choice-btn {
    text-align: left;
    padding: 9px 12px;
    border: 2px solid var(--ink-black);
    border-radius: 6px;
    background: var(--paper-warm);
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
}

.quiz-choice-btn:hover:not(:disabled) {
    background: var(--sticky-yellow);
}

.quiz-choice-btn.correct {
    background: #d4f5dd;
    border-color: var(--postal-green);
    color: var(--postal-green);
}

.quiz-choice-btn.wrong {
    background: #ffdcd9;
    border-color: var(--postal-red);
    color: var(--postal-red);
}

.mini-quiz-feedback {
    font-size: 0.88rem;
    font-weight: 700;
    padding: 9px;
    border-radius: 6px;
    background: var(--paper-warm);
    border-left: 5px solid var(--postal-green);
    line-height: 1.48;
}

.manual-scroll-body {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 6px;
}

.manual-section {
    background: #fff;
    border: 2px solid var(--ink-black);
    border-radius: 8px;
    padding: 12px;
}

.manual-section h4 {
    color: var(--postal-blue);
    margin-bottom: 5px;
    font-size: 1rem;
}

.manual-section p {
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 6px;
}

.manual-section ul {
    padding-left: 20px;
    font-size: 0.88rem;
    line-height: 1.55;
}

.modal-footer {
    display: flex;
    justify-content: flex-end;
}

.postal-footer {
    text-align: center;
    padding: 10px;
    font-size: 0.82rem;
    color: var(--ink-muted);
    font-weight: 900;
}

.hidden {
    display: none !important;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 880px) {
    .workspace-grid {
        flex-direction: column;
    }

    .operator-column {
        flex: none;
        width: 100%;
    }

    .parcels-row,
    .incoming-Pool,
    .ordered-slots,
    .device-parts-pool {
        grid-template-columns: repeat(2, 1fr);
    }
}